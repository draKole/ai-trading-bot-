# Drake AI Trading — Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env or real credentials to version control.

# ─── Operating Mode ──────────────────────────────────────────
# BACKTEST | PAPER | LIVE
TRADING_MODE=PAPER

# LIVE mode gate — must be explicitly set to "true" by owner
LIVE_ALLOWED=false

# ─── Database ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=drake_trading
POSTGRES_USER=drake
POSTGRES_PASSWORD=change_me_in_production

# TimescaleDB (same host/port, separate for clarity)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── API Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Authentication ──────────────────────────────────────────
# Required for Compose/deployment; inject from the environment or secret store.
# Never commit a real key. The application fallback is intentionally rejected by
# the deployment configuration check.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Market Data Provider ────────────────────────────────────
# Options: yfinance | polygon | ibkr | csv
DATA_PROVIDER=yfinance

# Polygon.io (if using)
POLYGON_API_KEY=

# Interactive Brokers (if using)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ─── Trading ─────────────────────────────────────────────────
DEFAULT_RISK_PERCENT=0.01
DEFAULT_MIN_RISK_REWARD=2.0
MAX_CONTRACTS=10
MAX_DAILY_LOSS_PERCENT=0.03
MAX_TRADES_PER_DAY=10
MAX_TRADES_PER_SESSION=5
MAX_CONSECUTIVE_LOSSES=3
STALE_SIGNAL_SECONDS=300

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=/var/log/drake/trading.log

# ─── Broker ──────────────────────────────────────────────────
# Leave empty unless connecting to a live broker
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=
